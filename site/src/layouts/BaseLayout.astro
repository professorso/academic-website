---
// BaseLayout.astro — HTML shell with fonts, nav, footer, contact modal
import { ClientRouter } from 'astro:transitions';
import Navbar from '../components/Navbar.astro';
import ContactModal from '../components/ContactModal.astro';
import CommandPalette from '../components/CommandPalette.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  // Accent tint for this page. See palette in global.css. Homepage
  // leaves this unset to keep the default MIT-red accent.
  accent?: 'navy' | 'blue' | 'grey' | 'maroon';
}

const {
  title = 'Eric So — MIT Professor of Global Economics and Behavioral Science',
  description = 'MIT Sloan professor Eric C. So on applied AI, financial markets, and human behavior. Publications, teaching, media, and his book The Collision.',
  accent,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentYear = new Date().getFullYear();
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const canonical = `${siteUrl}${Astro.url.pathname}`;

// Map the current pathname to its matching OG image.
// Pages live at /<slug>/ (e.g. /research/), root is 'index'.
const ogSlug = (() => {
  const p = Astro.url.pathname.replace(/^\/+|\/+$/g, '');
  return p === '' ? 'index' : p;
})();
const ogImage = `${siteUrl}${base}/og/${ogSlug}.png`;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Eric C. So',
  jobTitle: 'Sloan Distinguished Professor of Global Economics and Behavioral Science',
  affiliation: {
    '@type': 'CollegeOrUniversity',
    name: 'MIT Sloan School of Management',
    url: 'https://mitsloan.mit.edu',
  },
  url: siteUrl || 'https://ericso.pro',
  sameAs: [
    'https://mitsloan.mit.edu/faculty/directory/eric-so',
    'https://www.linkedin.com/in/eric-so-87531768/',
    'https://papers.ssrn.com/sol3/cf_dev/AbsByAuth.cfm?per_id=1431328',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Favicons. Multiple formats + sizes so Google Search, iOS home
         screen, and social share cards all pick a well-rendered version. -->
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32.png`} />
    <link rel="icon" type="image/png" sizes="48x48" href={`${base}/favicon-48.png`} />
    <link rel="icon" type="image/png" sizes="96x96" href={`${base}/favicon-96.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}/apple-touch-icon.png`} />

    <!-- Person schema for Google Knowledge Graph -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <ClientRouter />
  </head>
  <body data-accent={accent}>
    <a href="#main" class="skip-link">Skip to content</a>

    <div class="scroll-progress" aria-hidden="true"></div>
    <Navbar />
    <ContactModal />
    <CommandPalette />

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer section" data-theme="dark">
      <div class="section-inner footer-inner">
        <div class="footer-brand">
          <a href={`${base}/`} class="footer-logo">Eric So</a>
          <p class="footer-role">Sloan Distinguished Professor of Global Economics and Behavioral Science</p>
          <p class="footer-institution">MIT Sloan School of Management</p>
        </div>

        <nav class="footer-nav" aria-label="Footer navigation">
          <div class="footer-column">
            <p class="footer-heading">Explore</p>
            <a href={`${base}/research/`}>Research</a>
            <a href={`${base}/working-papers/`}>Working Papers</a>
            <a href={`${base}/the-collision/`}>The Collision</a>
            <a href={`${base}/resources/`}>Resources</a>
          </div>
          <div class="footer-column">
            <p class="footer-heading">Connect</p>
            <a href="https://mitsloan.mit.edu/faculty/directory/eric-so" target="_blank" rel="noopener">MIT Sloan Profile</a>
            <a href={`${base}/files/CV_EricSo.pdf`} target="_blank" rel="noopener">Curriculum Vitae</a>
            <a href="https://www.linkedin.com/in/eric-so-87531768/" target="_blank" rel="noopener">LinkedIn</a>
            <button type="button" data-contact-trigger>Contact</button>
          </div>
        </nav>

        <div class="footer-bottom">
          <address>100 Main Street · Cambridge, MA 02142</address>
          <div class="footer-legal">
            <span>© {currentYear} Eric So</span>
            <a href={`${base}/accessibility/`}>Accessibility</a>
          </div>
        </div>
      </div>
    </footer>

    <script is:inline data-astro-rerun>
      // Scroll progress bar — fills as the reader scrolls the page.
      // Writes a 0..1 value to --scroll-progress on <html>, which the
      // .scroll-progress bar in global.css reads for its width.
      (function () {
        const doc = document.documentElement;
        function update() {
          const scrollTop = doc.scrollTop || document.body.scrollTop;
          const scrollable = doc.scrollHeight - doc.clientHeight;
          const progress = scrollable > 0
            ? Math.min(1, Math.max(0, scrollTop / scrollable))
            : 0;
          doc.style.setProperty('--scroll-progress', progress.toFixed(4));
        }
        let ticking = false;
        function onScroll() {
          if (!ticking) {
            requestAnimationFrame(() => { update(); ticking = false; });
            ticking = true;
          }
        }
        update();
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', update, { passive: true });
      })();
    </script>

    <script is:inline data-astro-rerun src={`${base}/scripts/scroll-inversion.js`}></script>
    <script is:inline data-astro-rerun src={`${base}/scripts/particles.js`}></script>
  </body>
</html>

<style>
  .site-footer {
    padding: clamp(3.5rem, 7vw, 6rem) var(--section-pad-x) 2rem;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: minmax(260px, 1.35fr) minmax(320px, 1fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: start;
  }

  .footer-logo {
    display: inline-block;
    font-family: var(--font-display);
    font-size: var(--text-display-md);
    line-height: 0.95;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .footer-logo:hover {
    color: var(--accent);
  }

  .footer-role {
    max-width: 34ch;
    margin: 1rem 0 0.35rem;
    color: var(--gray-200);
    font-size: var(--text-body);
    line-height: 1.55;
  }

  .footer-institution {
    margin: 0;
    color: var(--gray-400);
    font-size: var(--text-small);
  }

  .footer-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
  }

  .footer-column {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.65rem;
  }

  .footer-heading {
    margin: 0 0 0.45rem;
    color: var(--gray-400);
    font-size: var(--text-meta);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .footer-column a,
  .footer-column button {
    padding: 0;
    color: var(--gray-200);
    font-family: var(--font-body);
    font-size: var(--text-small);
    line-height: 1.5;
    text-align: left;
  }

  .footer-column a:hover,
  .footer-column button:hover {
    color: var(--accent);
  }

  .footer-bottom {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--gray-800);
    color: var(--gray-400);
    font-size: var(--text-meta);
  }

  .footer-bottom address {
    font-style: normal;
  }

  .footer-legal {
    display: flex;
    gap: 1.25rem;
  }

  .footer-legal a {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .footer-legal a:hover {
    color: var(--white);
  }

  @media (max-width: 760px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .footer-bottom {
      grid-column: auto;
      flex-direction: column;
      gap: 0.75rem;
    }
  }
</style>
