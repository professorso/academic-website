---

<BaseLayout title="Research — Eric So" description="Published research by Eric So spanning behavioral finance, asset pricing, AI, and regulatory policy." accent="navy">
  <PageHeader label="Publications" title="Research" image="/images/backdrops/Sloan2.jpeg" />

  <section class="section sticky-intro" data-theme="light">
    <div class="sticky-intro-inner">
      <aside class="sticky-pane">
        <span class="section-label">Featured Research</span>
        <h2 class="sticky-title">Applied AI — in businesses, in markets, in our thinking.</h2>
        <p class="sticky-body">
          A rotating selection of recent and forthcoming papers that
          anchor my research agenda: how AI is changing the way investors,
          firms, and students reason about information and make decisions.
          Behavioral finance and information economics run through all of
          it as the anchor in how people — not just machines — actually
          behave.
        </p>
      </aside>
      <div class="reveal-pane">
        {featuredPapers.map((paper, i) => (
          <button type="button" class="reveal-card reveal-card--paper interactive-card" data-paper-trigger={paper.slug} aria-haspopup="dialog">
            <span class="reveal-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="reveal-meta">{paper.meta}</span>
            <h3 class="reveal-title reveal-title--paper">{paper.title}</h3>
            <p class="reveal-authors">{paper.authors}</p>
            <span class="reveal-link">View paper <span class="interaction-arrow" aria-hidden="true">→</span></span>
          </button>
        ))}
      </div>
    </div>
  </section>

  {categories.map((cat) => (
    <section class="section" data-theme="light">
      <div class="section-inner">
        <h2 class="category-title">{cat.name}</h2>
        <PaperList papers={cat.papers.map((paper) => ({
          title: paper.title,
          authors: paper.authors,
          status: paper.status,
          venue: paper.journal,
          detail: paper.volume,
          takeaway: paper.takeaway,
          link: paper.link,
        }))} />
      </div>
    </section>
  ))}

  <FeaturedResearchModal />
</BaseLayout>

<style>
  /* --- Editorial intro: sticky context on the left, featured cards on the right --- */
  .sticky-intro {
    padding-top: 2rem;
    padding-bottom: 2rem;
  }

  .sticky-intro-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--section-pad-x);
    display: grid;
    grid-template-columns: minmax(260px, 1fr) 1.4fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .sticky-pane {
    position: sticky;
    top: 7rem;
    padding: 2rem 0;
  }

  .sticky-title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    line-height: 1.05;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }

  .sticky-body {
    color: var(--gray-600);
    font-size: 1rem;
    line-height: 1.65;
    max-width: 42ch;
  }

  .reveal-pane {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-bottom: clamp(3rem, 10vh, 7rem);
  }

  .reveal-card {
    display: block;
    width: 100%;
    text-align: left;
    padding: 2rem 2rem 2rem 2.2rem;
    background: var(--pure-white);
    color: inherit;
    font: inherit;
    border: none;
    border-left: 3px solid var(--accent);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
  }

  .reveal-num {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.2em;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }

  .reveal-title {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.5vw, 1.8rem);
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .reveal-card p {
    color: var(--gray-600);
    line-height: 1.6;
  }

  /* Paper-variant reveal card (used on Research page). Clickable,
     shows a paper's venue/meta + authors + "Read Paper" affordance. */
  .reveal-card--paper {
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }

  .reveal-card--paper:hover,
  .reveal-card--paper:focus-visible {
    border-left-color: var(--accent);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
    background: var(--gray-100);
  }

  .reveal-meta {
    display: block;
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--gray-400);
    margin-bottom: 0.6rem;
  }

  .reveal-title--paper {
    font-family: var(--font-body);
    font-size: 1.1rem;
    font-weight: 600;
    text-transform: none;
    letter-spacing: 0;
    line-height: 1.4;
    margin-bottom: 0.5rem;
  }

  .reveal-authors {
    color: var(--gray-600);
    font-size: 0.9rem;
    line-height: 1.55;
    margin-bottom: 1rem;
  }

  .reveal-link {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
  }

  @media (max-width: 900px) {
    .sticky-intro-inner {
      grid-template-columns: 1fr;
    }
    .sticky-pane {
      position: static;
      padding: 0;
    }
    .reveal-pane {
      padding-bottom: 0;
    }
  }

  .category-title {
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--black);
  }

</style>
