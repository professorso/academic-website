---
// working-papers.astro — Current working papers
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import PaperList from '../components/PaperList.astro';

const papers = [
  {
    title: 'Emergent Negligence: How Profit Mandates Induce Alignment Failures in LLMs',
    authors: 'Eric So',
    status: 'Accepted' as const,
    venue: 'Conference on Language Models (COLM)',
    detail: '2026',
    takeaway: 'Shows how ordinary profitability mandates can lead LLMs to discount ambiguous safety signals even when risk remains visible in their reasoning.',
    link: '',
  },
  {
    title: 'Box Jumping: Portfolio Recompositions to Achieve Higher Morningstar Ratings',
    authors: 'Lauren Cohen, David S. Kim, Eric So',
    status: 'Working Paper' as const,
    venue: 'SSRN',
    detail: 'November 2024',
    takeaway: 'Examines how portfolio managers recompose holdings to cross Morningstar category boundaries and obtain more favorable ratings.',
    link: 'http://doi.org/10.2139/ssrn.4971228',
  },
  {
    title: 'AI Advisors and the Competence-Judgment Tradeoff in Information Disclosure',
    authors: 'Abigail B. Sussman, Eric C. So, Fiona Y. Yang',
    status: 'Working Paper' as const,
    venue: 'SSRN',
    detail: 'January 2026',
    takeaway: 'Examines how people trade off expertise against fear of judgment when deciding whether to disclose information to human or AI advisors.',
    link: 'https://papers.ssrn.com/sol3/papers.cfm?abstract_id=6077326',
  },
  {
    title: 'When AI Speaks, Do We Listen? Examining Factors in the Uptake of LLM Advice',
    authors: 'Andrew Lo, Jillian Ross, Eric So',
    status: 'Working Paper' as const,
    venue: 'Research in progress',
    takeaway: 'Studies the conditions that determine whether people accept, discount, or act on advice generated by large language models.',
    link: '',
  },
  {
    title: 'Fee the People',
    authors: 'Omri Even-Tov, Kimberlyn George, Shimon Kogan, Eric So',
    status: 'Working Paper' as const,
    venue: 'Research in progress',
    takeaway: 'Investigates how fee structures affect investor behavior and the distribution of costs across market participants.',
    link: '',
  },
];
---

<BaseLayout title="Working Papers — Eric So" description="Current working papers and research in progress by Eric So." accent="blue">
  <PageHeader label="Research" title="Working Papers" image="/images/backdrops/blurred-abstract-background-interior-view-looking-out-toward-empty-office-lobby-entrance-doors-glass-curtain-wall-with-frame.jpg" />

  <section class="section" data-theme="light">
    <div class="section-inner">
      <PaperList papers={papers} headingLevel={2} />
    </div>
  </section>
</BaseLayout>
