---
// PhotoStrip.astro — User-controlled horizontal strip of action photos
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const photos = [
  { src: `${base}/images/Action1.jpg`, alt: 'Eric So speaking' },
  { src: `${base}/images/Action2.jpg`, alt: 'Eric So presenting' },
  { src: `${base}/images/IDE1.jpg`, alt: 'Eric So at MIT IDE Conference' },
  { src: `${base}/images/Action3.jpg`, alt: 'Eric So at conference' },
  { src: `${base}/images/Action6.jpg`, alt: 'Eric So teaching' },
  { src: `${base}/images/Action8.jpg`, alt: 'Eric So speaking' },
  { src: `${base}/images/IDE2.jpg`, alt: 'Eric So at MIT IDE Conference' },
  { src: `${base}/images/Action7.jpg`, alt: 'Eric So in discussion' },
  { src: `${base}/images/Action10.jpg`, alt: 'Eric So presenting' },
];
---

<div class="strip-wrapper" aria-label="Selected photographs; scroll horizontally to view more" role="region" tabindex="0">
  <div class="strip-track" role="list">
    {photos.map((photo) => (
      <div class="strip-item" role="listitem">
        <img src={photo.src} alt={photo.alt} loading="lazy" />
      </div>
    ))}
  </div>
</div>

<style>
  .strip-wrapper {
    overflow-x: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--gray-600) var(--black);
    overscroll-behavior-inline: contain;
    scroll-snap-type: inline proximity;
    padding: 1rem 0;
    background: var(--black);
  }

  .strip-track {
    display: flex;
    gap: 1rem;
    width: max-content;
    padding: 0 var(--section-pad-x);
  }

  .strip-item {
    flex-shrink: 0;
    width: 320px;
    height: 220px;
    overflow: hidden;
    scroll-snap-align: start;
  }

  .strip-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  @media (max-width: 768px) {
    .strip-item {
      width: 240px;
      height: 160px;
    }
  }
</style>
